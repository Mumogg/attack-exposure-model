# Copie este archivo como .env y complete su clave. Nunca suba .env al repositorio.
GEMINI_API_KEY=
# Modelo por defecto y alternativo (verifique la lista vigente en https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Solicitudes por minuto permitidas (capa gratuita; valor aproximado, no oficial)
GEMINI_RPM=10
# Reintentos ante HTTP 429 / 5xx
GEMINI_MAX_RETRIES=5
